{
  "name": "ui5-task-copy-resources",
  "version": "0.0.1",
  "private": false,
  "description": "Task for ui5-builder which just copy resources from one place to another without any changes",
  "keywords": [
    "builder",
    "copy",
    "files",
    "move",
    "resources",
    "task",
    "tooling",
    "ui5"
  ],
  "homepage": "https://github.com/mauriciolauffer/ui5-task-copy-resources#readme",
  "bugs": {
    "url": "https://github.com/mauriciolauffer/ui5-task-copy-resources/issues"
  },
  "license": "MIT",
  "author": "Mauricio Lauffer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mauriciolauffer/ui5-task-copy-resources.git"
  },
  "files": [
    "dist/**",
    "ui5.yaml"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && echo 'module.exports = exports.default;' >> dist/index.js",
    "test": "vitest run",
    "lint": "eslint lib test --ext .ts",
    "lint:fix": "eslint lib test --ext .ts --fix",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^8.57.1",
    "eslint-config-mlauffer-nodejs": "0.0.1",
    "oxfmt": "^0.33.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
